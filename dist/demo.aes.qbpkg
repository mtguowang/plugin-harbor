{
  "qbpkg": "1.0",
  "manifest": {
    "id": "demo.aes",
    "name": "AES 加密演示",
    "version": "1.0.0",
    "engine": ">=1.0 <2.0",
    "author": "demo",
    "description": "AES-CBC / AES-ECB 加密演示（固定 key/iv）。纯本地计算，不访问网络。",
    "allowHosts": [
      "demo.invalid"
    ],
    "inputs": [
      {
        "key": "text",
        "label": "输入文本",
        "type": "text",
        "required": true,
        "placeholder": "随便填点什么",
        "maxLength": 200
      }
    ],
    "vars": {
      "demoHost": "https://demo.invalid"
    },
    "flow": [
      {
        "id": "calc",
        "type": "set",
        "set": {
          "vars": {
            "out1": "{{fn.md5(input.text)}}",
            "out2": "{{fn.sha256(input.text)}}",
            "out3": "{{fn.b64(input.text)}}",
            "outLen": "{{fn.len(input.text)}}",
            "outTs": "{{fn.ts13()}}",
            "outRand": "{{fn.randomHex(16)}}"
          }
        }
      },
      {
        "id": "done",
        "type": "set",
        "end": true,
        "set": {
          "vars": {
            "finalMsg": "计算完成"
          }
        }
      }
    ],
    "output": {
      "title": "AES 加密演示",
      "fields": [
        {
          "label": "输入长度",
          "value": "{{vars.outLen}}"
        },
        {
          "label": "MD5",
          "value": "{{vars.out1}}"
        },
        {
          "label": "SHA256",
          "value": "{{vars.out2}}"
        },
        {
          "label": "Base64",
          "value": "{{vars.out3}}"
        },
        {
          "label": "时间戳",
          "value": "{{vars.outTs}}"
        },
        {
          "label": "随机 hex",
          "value": "{{vars.outRand}}"
        }
      ]
    }
  },
  "meta": {
    "exportedAt": "2026-10-27T01:30:00Z",
    "exportedBy": "demo-gen"
  }
}